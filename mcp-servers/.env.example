# mcp-servers 环境变量示例。复制为 .env 后填入实际值。
# 知识库相关项须与 backend/.env 严格一致（EMBEDDING_DIMS 两边必须相同）。

# ---- MinIO ----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=uploads
MINIO_SECURE=false

# ---- 临时文件 ----
WRAPPER_TMP_DIR=./tmp

# ---- Server ----
HOST=0.0.0.0
PORT=8088

# ---- 第三方 MCP（zai-mcp-server）----
Z_AI_API_KEY=
Z_AI_MODE=

# ---- Elasticsearch（知识库向量检索存储）----
ES_URL=http://localhost:9200
# ES_API_KEY=
# ES_USER=elastic
# ES_PASSWORD=

# ---- 向量化（TEI OpenAI 兼容端点）----
# 本地 TEI：model 任意（TEI 忽略）、check_embedding_ctx_length 必须 False。
# EMBEDDING_DIMS：全局唯一来源，backend(入库) 与 mcp-servers(检索) 必须读同一值。
EMBEDDING_BASE_URL=http://localhost:8082/v1
EMBEDDING_API_KEY=-
EMBEDDING_MODEL=text-embeddings-inference
EMBEDDING_CHECK_CTX_LENGTH=false
EMBEDDING_DIMS=512
EMBEDDING_TIMEOUT=30
EMBEDDING_BATCH_SIZE=24

# ---- 知识库检索默认参数 ----
KB_TOP_K=5
