# ===== goduck-platform backend env =====
# 复制本文件为 .env 并按需修改。默认值已与根目录 docker-compose.yml 对齐，
# 若用 docker-compose 启动 PostgreSQL + MinIO，可直接使用以下默认值本地测试。

# ---- App ----
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# 反代 root_path：生产经 nginx(剥 /api) 时设为 /api；本地直连留空(默认即空，dev 无需设)
# ROOT_PATH=

# ---- 登录认证（用户体系）----
# 启动引导用户（create-if-absent，逗号分隔多条）：
#   用户名:昵称:角色:密码   角色 manager|user
# 密码仅首次建户生效（哈希入库）；已存在用户以库内为准，env 永不覆盖应用内修改。
# 改密/改昵称走平台内（个人中心）。至少引导一个 manager。
BOOTSTRAP_USERS=管理员用户名:昵称:manager:强密码
# 登录会话有效期（小时）；改密/停用/管理员重置即时吊销全部会话。
AUTH_SESSION_TTL_HOURS=168

# ---- PostgreSQL ----
# docker-compose 默认: 用户 goduck / 密码 changeme / 库 langgraph_db / 宿主端口 5433
DATABASE_URL=postgresql://goduck:changeme@localhost:5433/langgraph_db
DB_POOL_MAX_SIZE=10

# ---- Agent runtime ----
# 模型 (LLM) 现已迁移到 `model` 表，通过 /models API 注册，不再用环境变量配置。
MAX_INVOKE_RETRIES=2

# ---- Local filesystem roots (config-injected, never hardcoded) ----
# 相对路径锚定到后端包根：默认 "data" → backend/data/{workspace,memories,skills}。
# 容器内 compose 覆盖为 /data（绝对，命名卷挂载点）。
LOCAL_ROOT=data

# ---- MCP safety ----
# MCP servers / 模型 均通过 DB 表注册 (/mcp/servers, /models)，重启自动加载。
MCP_ALLOW_LOOPBACK=true
# 单个 MCP server 连接超时（秒）。stdio server 用 uvx/uv 启动时首次运行需向包索引
# 下载依赖：若 pypi 不可达（无镜像 env），每次重连会重试 ~44s——该超时保证整轮
# refresh 与保存接口有界。stdio server 配置可加 env.UV_DEFAULT_INDEX 指向镜像。
MCP_CONNECT_TIMEOUT=45
# 内置 MCP（goduck：kb_search / image_understand，backend 进程内 FastMCP）端点 URL。
# 本地留空 = 自动推导 http://127.0.0.1:8000/mcp；容器部署显式设 http://backend:8000/mcp。
BUILTIN_MCP_URL=

# ---- MinIO (附件字节持久层) ----
# docker-compose 默认: 端口 9000 / 用户 minioadmin / 密码 minioadmin123
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=uploads
MINIO_SECURE=false

# ---- 附件上传约束 ----
# 单文件大小上限（MB）：会话附件与 KB 知识库文档共用（后端 FastAPI 413 友好文案）。
# 生产 compose 经根目录 docker-compose.yml 透传本值；同步约束：边缘 nginx
# nginx.conf 的 client_max_body_size（2100m）须 ≥ 此值，否则先撞 nginx 裸 413。
# 生产/测试部署按需调大（如 2048=2G），本地默认 10。
ATTACHMENT_MAX_SIZE_MB=2048
# 每条消息最多携带附件数（发送门校验；非上传批量上限，上传批量限制在前端，单批 4 个）
ATTACHMENT_MAX_IMAGES_PER_MESSAGE=4

# ---- Elasticsearch（知识库向量/全文检索存储）----
# docker-compose 默认: http://elasticsearch:9200（容器内）/ http://localhost:9200（宿主调试）
ES_URL=http://localhost:9200
# 生产启用安全时填（dev compose 已关闭 xpack.security）：
# ES_API_KEY=
# ES_USER=elastic
# ES_PASSWORD=

# ---- 向量化（注册化主路径 + env 兜底）----
# 主路径：向量模型在平台内注册（/settings/embeddings 页面或 /embeddings API），
#   建库时绑定（维度随行走）。本组 env 仅两用：
#   ① 首次启动 seed 一条默认向量模型行（值与本组同源，存量库自动回填绑定）；
#   ② 未绑定库检索的回落路径（行为=历史版本）。
# 本地 TEI：只要 URL 指向 /v1 正确，其余参数任意（无 key、model 任意，TEI 部署时已指定模型）。
#   见 demo/agents/embeddings.py。check_embedding_ctx_length 必须为 false（否则 tiktoken 报错）。
EMBEDDING_BASE_URL=http://localhost:8082/v1
EMBEDDING_API_KEY=-
EMBEDDING_MODEL=text-embeddings-inference
EMBEDDING_CHECK_CTX_LENGTH=false
EMBEDDING_DIMS=512
# seed 默认行名（仅首次建行生效；行被改名即视为用户接管，重启不再按名重建）
EMBEDDING_SEED_NAME=Qwen3-Embedding-0.6B（TRL 512）
# 单次 /v1/embeddings 请求最大文本数。须 ≤ TEI --max-client-batch-size（默认32，超则 422）。
# 延迟关键：单请求总 token 超 TEI --max-batch-tokens（默认16384）时拆多轮前向推理，
#   请求挂起时间成倍放大（compose 内置 tei 已设 32768 并配 batch=24）。
EMBEDDING_BATCH_SIZE=4
# 单批嵌入请求超时（秒），必须 > 单批实际耗时。batch=4 对齐 TEI 后约 6.5s，默认 90s。
EMBEDDING_TIMEOUT=90

# ---- 知识库 / RAG ----
KB_ENABLED=true
KB_STORE_MINIO=true
KB_TOP_K=5
KB_CHUNK_SIZE=800
KB_CHUNK_OVERLAP=120

# ---- 知识库解析引擎 ----
# legacy（默认）= 轻量基线：pymupdf 文本层+滑窗切块（无 OCR，扫描件报错
# 指引切换 docling）；docling = 结构单元 IR 直入 ES（splitter 退役仅预算
# 护栏；证据锚定 heading_path/bbox/doc_uri；docx 直解无 anchor，前端文本
# 态降级；管线内 RapidOCR 仅扫描页兜底——扫描件解析为 docling 专属）。
# 切 docling 前须安装 docling>=2.130,<3 + langdetect；未安装时入库显式
# failed（提示安装），默认 legacy 路径不受影响。
KB_PARSER_ENGINE=legacy
# 长文档分片页数（片=独立 convert + 独立 IR 边车断点续跑；Phase A 校准）
KB_DOCLING_SHARD_PAGES=100
# CPU 并行度旋钮（AcceleratorOptions.num_threads；convert 进程内串行；
# 仅设备为 cpu 时生效，GPU 算子不吃该值）
KB_DOCLING_THREADS=4
# 推理设备 auto/cpu/cuda/mps：auto=按 torch 探测 cuda→mps→cpu（无 GPU 安全
# 回落 cpu）；生产 GPU 主机可显式锁 cuda（容器 GPU 声明见 docker-compose.gpu.yml，
# 本地直跑装的是 PyPI CPU 版 torch，设 cuda 也不会有 GPU）。注意 OCR 走
# onnxruntime，其 provider 跟随 docling 版本处理，GPU 加速主要覆盖
# layout/TableFormer。
# 值变更会使分片 IR 边车缓存失效（重跑解析，维持重建可复现）。
KB_DOCLING_DEVICE=auto
# 预置模型权重目录：生产必填（禁运行时下载模型），由 docling-tools models
# download 与运行时同版本物化（完整 layout+tableformer 工件布局）。留空 =
# docling 默认解析：新版 docling 从 HuggingFace hub 缓存（~/.cache/huggingface/
# hub，Win 同）直接加载 docling-models / docling-layout-heron 等仓库，首次
# 解析仅做 etag 校验不重复下载；HF hub 缓存已就绪且需完全断网时加
# HF_HUB_OFFLINE=1。国内免梯子下载另加 HF_ENDPOINT=https://hf-mirror.com。
# 注意：hub 缓存目录不能直接填本值（布局不完整不兼容）。
KB_DOCLING_ARTIFACTS_PATH=
# 结构单元预算上界（超预算在子区域边界再切，携带 heading_path）；
# 勿调超过 TEI 端点实际 max sequence length（否则静默截断制造边界盲切）
KB_UNIT_MAX_CHARS=2000

# ---- 语音输入（STT 触发会话，AssemblyAI Streaming）----
# 总开关：false 时不挂载 /sessions/{id}/voice WS 路由（健康能力位同步为 false）。
VOICE_ENABLED=false
# AssemblyAI API key（https://www.assemblyai.com/）；VOICE_ENABLED=true 时必填。
ASSEMBLYAI_API_KEY=
# STT 采样率（PCM16 mono，前端采麦按此重采样；与 AssemblyAI 连接参数一致）。
STT_SAMPLE_RATE=16000
# AssemblyAI Streaming 语音模型（v3 speech_model 连接参数，可切换）。中文必须用旗舰模型：
#   universal-3-5-pro                   18 语种含中文（ZH）/日语，语种间码切换（官方默认）
#   universal-streaming-english         仅英语（低成本）
#   universal-streaming-multilingual    EN/ES/DE/FR/PT/IT（不含中文）
# 注意：流式 STT 不支持 language_code（那是预录制音频专用参数），语言能力由模型决定。
STT_SPEECH_MODEL=universal-3-5-pro
# 松开麦克风后等待供应商终稿的兜底秒数（超时按空转写收场，不让回合挂死）。
STT_FLUSH_TIMEOUT=5
# 浏览器⇄后端常驻 WS 空闲期应用层 ping 间隔（秒），穿透反代保活。
VOICE_HEARTBEAT_INTERVAL=30
# 常驻 WS 最大空闲秒数，超时服务端 close(4408) 回收（客户端自动重连）。
VOICE_IDLE_TIMEOUT=600

# ---- Jev Shell 守卫（allow_shell HITL 减负；判决后端 = laya-serve，Jev wire 协议）----
# 总开关：false 时构建回落 interrupt_on={'execute': True}（每条 shell 命令弹卡，
# 与现状逐字节一致）。本地开发（无 laya）保持 false——懒连接，启动零依赖；
# true 且 key 就绪时：L1 确定性直通（只读白名单 + 在册 MCP 前置补齐 + 工作区
# 常规操作）+ 灰区命令经 Jev 概率门控决定"是否跳过人工"；判定失败/超时一律
# 问人（fail-closed，绝不放行）。
JEV_ENABLED=false
# 判决端点认证 key：laya 部署下与 compose 的 LAYA_API_KEY 同值（一把钥匙两端，
# 字段名沿用历史契约）；JEV_ENABLED=true 时必填，缺失则守卫不启用 + 启动警告。
TYPESAFE_API_KEY=
# Jev wire 端点根（POST {base}/v1/systemone）。compose 缺省指内置 laya-serve；
# 后端恒显式传参给 TypeSafeClassifier——改地址只认 JEV_BASE_URL。
JEV_BASE_URL=http://laya:8000
# 模型名：须为 laya 侧注册名（LAYA_EXTRA_MODELS 同名注册）。
JEV_MODEL=multilingual
# 同步调用硬超时（秒）。when 门控在 after_model 内同步执行，超时即回落问人。
JEV_TIMEOUT_SECONDS=2.0
# enforce=灰区放行生效；shadow=只判只落审计（灰度观察态）。阈值未标定切
# enforce 时，灰区判决自然回落人工（宁多问不误放）。
JEV_MODE=enforce
# 自动放行阈值（概率落在安全侧 ∧ 该题置信度达标，全票才放行）。
# 0.9 为保守占位；按 shadow 期人工同意率重标定后更新。
JEV_SAFE_THRESHOLD=0.9
# 送判 state 渲染截断上限（字符，含近期命令历史）。
JEV_STATE_MAX_CHARS=4000
# L1 允许项扩展：在册 MCP 前置依赖补齐（uvx --from / uv|pip install，包名取自
# mcp_server 表登记）+ 工作区常规操作（mkdir/cp/mv/touch/python 脚本，仅相对
# 路径）零审批直通；&& 复合链逐段判定，任一段不属允许面整链落 L2。
# false = 行为回到扩展前（一键回退）。变更随图构建烘焙（重启或 TTL 过期再生效）。
JEV_SHELL_L1_ALLOW=true
# 额外放行包名（逗号分隔；与 mcp_server 表登记包并集）。
JEV_SHELL_ALLOW_PKGS=
# JEV_PROXY_URL 已退役（laya 自托管无 451 地域封锁），保留字段兼容旧 .env。
JEV_PROXY_URL=

# ---- Jev Rubric 门控（grader 分诊）----
# 前置：JEV_ENABLED=true 且 TYPESAFE_API_KEY 就绪。false 时节点 grader='jev'
# 构建回落 llm 路径 + 构建期 warning（一键回退保险丝，不动 agent 配置）。
JEV_RUBRIC_ENABLED=false
# rubric 快道默认阈值（P 与 conf 双轴同值）。三级解析：行级 criterion.threshold
# ← 节点级 pass_threshold ← 本值。配置即契约（无 shadow 态）——保守起步，
# 靠审计（灰区轮 JEV+LLM 双判决）后验调优。
JEV_RUBRIC_PASS_THRESHOLD=0.9

# ---- Jev KB 检索门控（Agentic RAG 相关性过滤）----
# 前置：JEV_ENABLED=true 且 TYPESAFE_API_KEY 就绪。false 时构建不挂载
# （行为=现状）。平台级开关，作用于所有 allow_knowledge 主代理；Jev 不可用/
# 返回格式漂移一律原样透传（fail-closed = 现状行为）。
JEV_KB_RERANK_ENABLED=false
# 运行态三档：shadow=只判只落审计（校准态，不改写结果）；annotate=每 chunk
# 加 [相关性] 前缀标注不删除；enforce=高置信无关才滤（keep_floor 保底）。
# 灰度顺序 shadow→annotate→enforce。
JEV_KB_MODE=shadow
# 问题形态为两选项 choice（yes/no，laya #156 缓解：noul 长文概率饱和）。
# drop 侧阈值（不对称规则：rel/info 两题 P(yes)≤此值 ∧ conf≥confidence
# 同时成立才滤；任一维度存疑一律保留）。阈值待 shadow 期分布重拟合。
JEV_KB_DROP_PROBABILITY=0.15
JEV_KB_DROP_CONFIDENCE=0.90
# ES 序前 N 条永不滤（只修剪尾部不斩首；输出集合永不为空的保底）。
JEV_KB_KEEP_FLOOR=2
# kb 门控独立 Jev 调用预算（秒；本地部署 RTT 小，与 shell 守卫预算分离）。
JEV_KB_TIMEOUT_SECONDS=2.0
# 送判 state 本地上限（字符，≈8k token 安全界）：超限不送判，按 unavailable
# 透传（宁拒不发残卷）。
JEV_KB_STATE_MAX_CHARS=12000
# 两段式检索（默认关）：>0 时 pre-wrap 过采 k、post-wrap 筛回（recall 净增）；
# Jev 不可用时按 ES 序截回原始 k（故障形态=现状）。
JEV_KB_K_BOOST=0
