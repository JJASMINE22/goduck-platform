# ===== goduck-platform backend env =====
# 复制本文件为 .env 并按需修改。默认值已与根目录 docker-compose.yml 对齐，
# 若用 docker-compose 启动 PostgreSQL + MinIO，可直接使用以下默认值本地测试。

# ---- App ----
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# 反代 root_path：生产经 nginx(剥 /api) 时设为 /api；本地直连留空(默认即空，dev 无需设)
# ROOT_PATH=

# ---- PostgreSQL ----
# docker-compose 默认: 用户 goduck / 密码 changeme / 库 langgraph_db / 宿主端口 5433
DATABASE_URL=postgresql://goduck:changeme@localhost:5433/langgraph_db
DB_POOL_MAX_SIZE=10

# ---- Agent runtime ----
# 模型 (LLM) 现已迁移到 `model` 表，通过 /models API 注册，不再用环境变量配置。
MAX_INVOKE_RETRIES=2

# ---- Local filesystem roots (config-injected, never hardcoded) ----
# 相对路径锚定到后端包根：默认 "data" → backend/data/{workspace,memories,skills}。
# 容器内 compose 覆盖为 /data（绝对，命名卷挂载点）。
LOCAL_ROOT=data

# ---- MCP safety ----
# MCP servers / 模型 均通过 DB 表注册 (/mcp/servers, /models)，重启自动加载。
MCP_ALLOW_LOOPBACK=true
# 单个 MCP server 连接超时（秒）。stdio server 用 uvx/uv 启动时首次运行需向包索引
# 下载依赖：若 pypi 不可达（无镜像 env），每次重连会重试 ~44s——该超时保证整轮
# refresh 与保存接口有界。stdio server 配置可加 env.UV_DEFAULT_INDEX 指向镜像。
MCP_CONNECT_TIMEOUT=45

# ---- MinIO (附件字节持久层) ----
# docker-compose 默认: 端口 9000 / 用户 minioadmin / 密码 minioadmin123
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=uploads
MINIO_SECURE=false

# ---- 附件上传约束 ----
ATTACHMENT_MAX_SIZE_MB=10
ATTACHMENT_MAX_IMAGES_PER_MESSAGE=2

# ---- Elasticsearch（知识库向量/全文检索存储）----
# docker-compose 默认: http://elasticsearch:9200（容器内）/ http://localhost:9200（宿主调试）
ES_URL=http://localhost:9200
# 生产启用安全时填（dev compose 已关闭 xpack.security）：
# ES_API_KEY=
# ES_USER=elastic
# ES_PASSWORD=

# ---- 向量化（TEI 经 OpenAI 兼容端点；单一固定后端 + 全局单一维度）----
# 本地 TEI：只要 URL 指向 /v1 正确，其余参数任意（无 key、model 任意，TEI 部署时已指定模型）。
#   见 demo/agents/embeddings.py。check_embedding_ctx_length 必须为 false（否则 tiktoken 报错）。
# EMBEDDING_DIMS 是唯一来源：backend(入库) 与 mcp-servers(检索) 必须读同一值（维度对称）。
EMBEDDING_BASE_URL=http://192.168.22.23:8082/v1
EMBEDDING_API_KEY=-
EMBEDDING_MODEL=text-embeddings-inference
EMBEDDING_CHECK_CTX_LENGTH=false
EMBEDDING_DIMS=512
# 单次 /v1/embeddings 请求最大文本数。须 ≤ TEI --max-client-batch-size（默认32，超则 422）。
# 超时关键：须对齐 TEI --max-batch-size（默认4）。客户端 batch > 它时单请求内做多轮前向推理，
#   请求挂起时间放大 → 并发下易超时。对齐后每请求 1 轮推理（800字中文实测 batch=4→6.5s）。
EMBEDDING_BATCH_SIZE=4
# 单批嵌入请求超时（秒），必须 > 单批实际耗时。batch=4 对齐 TEI 后约 6.5s，默认 90s。
EMBEDDING_TIMEOUT=90

# ---- 知识库 / RAG ----
KB_ENABLED=true
KB_STORE_MINIO=true
KB_TOP_K=5
KB_CHUNK_SIZE=800
KB_CHUNK_OVERLAP=120

# ---- 语音输入（STT 触发会话，AssemblyAI Streaming）----
# 总开关：false 时不挂载 /sessions/{id}/voice WS 路由（健康能力位同步为 false）。
VOICE_ENABLED=false
# AssemblyAI API key（https://www.assemblyai.com/）；VOICE_ENABLED=true 时必填。
ASSEMBLYAI_API_KEY=
# STT 采样率（PCM16 mono，前端采麦按此重采样；与 AssemblyAI 连接参数一致）。
STT_SAMPLE_RATE=16000
# AssemblyAI Streaming 语音模型（v3 speech_model 连接参数，可切换）。中文必须用旗舰模型：
#   universal-3-5-pro                   18 语种含中文（ZH）/日语，语种间码切换（官方默认）
#   universal-streaming-english         仅英语（低成本）
#   universal-streaming-multilingual    EN/ES/DE/FR/PT/IT（不含中文）
# 注意：流式 STT 不支持 language_code（那是预录制音频专用参数），语言能力由模型决定。
STT_SPEECH_MODEL=universal-3-5-pro
# 松开麦克风后等待供应商终稿的兜底秒数（超时按空转写收场，不让回合挂死）。
STT_FLUSH_TIMEOUT=5
# 浏览器⇄后端常驻 WS 空闲期应用层 ping 间隔（秒），穿透反代保活。
VOICE_HEARTBEAT_INTERVAL=30
# 常驻 WS 最大空闲秒数，超时服务端 close(4408) 回收（客户端自动重连）。
VOICE_IDLE_TIMEOUT=600

# ---- Jev Shell 守卫（allow_shell HITL 减负，TypeSafe System One）----
# 总开关：false 时构建回落 interrupt_on={'execute': True}（每条 shell 命令弹卡，
# 与现状逐字节一致）。true 且 key 就绪时：只读白名单静默直通 + 灰区命令经 Jev
# 概率门控决定"是否跳过人工"；判定失败/超时一律问人（fail-closed，绝不放行）。
JEV_ENABLED=false
# TypeSafe AI API key（https://docs.typesafe.ai）；JEV_ENABLED=true 时必填，
# 缺失则守卫不启用 + 启动警告（不崩，行为回落全人工）。
TYPESAFE_API_KEY=
# REST 端点根（POST {base}/v1/systemone）。
# 注意：后端恒显式传参给 TypeSafeClassifier（优先级高于库的
# TYPESAFE_BASE_URL / TYPESAFE_API_KEY env 回退）——改地址只认 JEV_BASE_URL。
JEV_BASE_URL=https://api.typesafe.ai
# 模型版本：锁具体版本号、不用 jev-latest 别名（防静默行为漂移）。
JEV_MODEL=jev-1.13.0
# 同步调用硬超时（秒）。when 门控在 after_model 内同步执行，超时即回落问人。
JEV_TIMEOUT_SECONDS=2.0
# shadow=只记录标注、行为与现状一致（灰度观察期）；enforce=灰区放行生效。
# 必须先用 shadow 期分歧样本重标定 JEV_SAFE_THRESHOLD 再切 enforce。
JEV_MODE=shadow
# 自动放行阈值（概率落在安全侧 ∧ 该题置信度达标，全票才放行）。
# 0.9 为占位值；shadow 期按人工同意率重标定后更新。
JEV_SAFE_THRESHOLD=0.9
# 送判 state 渲染截断上限（字符，含近期命令历史）。
JEV_STATE_MAX_CHARS=4000
