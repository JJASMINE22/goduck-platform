# ===== goduck-platform backend env =====
# 复制本文件为 .env 并按需修改。默认值已与根目录 docker-compose.yml 对齐，
# 若用 docker-compose 启动 PostgreSQL + MinIO，可直接使用以下默认值本地测试。

# ---- App ----
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ---- PostgreSQL ----
# docker-compose 默认: 用户 goduck / 密码 changeme / 库 langgraph_db / 宿主端口 5433
DATABASE_URL=postgresql://goduck:changeme@localhost:5433/langgraph_db
DB_POOL_MAX_SIZE=10

# ---- Agent runtime ----
# 模型 (LLM) 现已迁移到 `model` 表，通过 /models API 注册，不再用环境变量配置。
MAX_INVOKE_RETRIES=2

# ---- Local filesystem roots (config-injected, never hardcoded) ----
LOCAL_ROOT=.

# ---- MCP safety ----
# MCP servers / 模型 均通过 DB 表注册 (/mcp/servers, /models)，重启自动加载。
MCP_ALLOW_LOOPBACK=true

# ---- MinIO (附件字节持久层) ----
# docker-compose 默认: 端口 9000 / 用户 minioadmin / 密码 minioadmin123
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=uploads
MINIO_SECURE=false

# ---- 附件上传约束 ----
ATTACHMENT_MAX_SIZE_MB=10
ATTACHMENT_MAX_IMAGES_PER_MESSAGE=2
