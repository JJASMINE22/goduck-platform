# goduck-platform 部署覆盖模板 —— 复制为根目录 .env（已 gitignore，绝不提交）。
# 取值优先级：shell 环境变量 > 本文件 > docker-compose.yml 内默认值。
# 只有想改默认值时才需取消注释；「凭据」段生产建议必填。

# ===================== 凭据（生产必填/必改）=====================
# 数据库（注意：仅在 pgdata 卷首次初始化时生效，跑起来后再改不改库内密码）
# POSTGRES_PASSWORD=changeme
# MinIO 控制台/接口
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin123
# 语音输入（AssemblyAI Streaming STT；key 留空自动关闭，前端无麦克风入口）
# VOICE_ENABLED=true
# ASSEMBLYAI_API_KEY=
# Jev 守卫（判决后端 = compose 内置 laya-serve，Jev wire 协议；key 留空自动
# 回落全人工审批，不崩。本地开发无 laya 时保持 JEV_ENABLED=false 即可——
# 懒连接，启动零依赖）
# JEV_ENABLED=true
# TYPESAFE_API_KEY=                # 与 laya 段 LAYA_API_KEY 同值（一把钥匙两端）
# JEV_MODE=enforce                 # enforce=灰区自动放行生效；shadow=只判只落审计
# JEV_SAFE_THRESHOLD=0.45          # L2 自动放行阈值（P 与 conf 双轴）；调低=放行面更宽
# L1 允许项扩展（在册 MCP 前置依赖补齐 + 工作区常规操作零审批直通）：
# false = 一键回退扩展前行为；额外放行包名逗号分隔（与 mcp_server 表并集）。
# JEV_SHELL_L1_ALLOW=true
# JEV_SHELL_ALLOW_PKGS=
# JEV_PROXY_URL 已退役（laya 自托管无 451 地域封锁），留空即可。

# ===================== 登录认证（用户体系）=====================
# 启动引导用户（create-if-absent，逗号分隔多条）：用户名:昵称:角色:密码
# 密码仅首次建户生效；改密/改昵称走平台内（个人中心）。生产至少引导一个 manager。
# BOOTSTRAP_USERS=管理员用户名:昵称:manager:强密码
# 登录会话有效期（小时）
# AUTH_SESSION_TTL_HOURS=168

# ===================== 端口 / 数据根 =====================
# EDGE_PORT=80                   # 平台唯一对外端口
# VOLUMES_ROOT=./volumes         # backend 数据 / docling 模型 / TEI 模型的宿主机根目录
# POSTGRES_PORT=5433             # 以下调试端口均绑定 127.0.0.1，LAN 不可见
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# ES_PORT=9200
# TEI_PORT=8082

# ===================== 基础设施账号/库名 =====================
# POSTGRES_USER=goduck
# POSTGRES_DB=langgraph_db
# MINIO_BUCKET=uploads

# ===================== 后端运行时 =====================
# LOG_LEVEL=INFO
# ROOT_PATH=/api
# MAX_INVOKE_RETRIES=2
# DB_POOL_MAX_SIZE=10
# 附件/KB 文档单文件上传上限（MB）：会话附件与知识库文档共用；生产/测试
# 建议 2048（2G）。同步约束：边缘 nginx client_max_body_size（2100m）须 ≥
# 此值，否则先撞 nginx 裸 413。本地默认 10。
# ATTACHMENT_MAX_SIZE_MB=2048
# 每条消息最多携带附件数（发送门校验；非上传批量上限，上传批量限制在前端，单批 4 个）
# ATTACHMENT_MAX_IMAGES_PER_MESSAGE=4

# ===================== TEI 嵌入服务 =====================
# TEI_IMAGE=cuda-1.9             # CPU 机器用 cpu-1.9
# TEI_MODEL_ID=/data/Qwen3-Embedding-0.6B   # 容器内本地目录；或 HF repo id（首启下载）
# HF_ENDPOINT=https://hf-mirror.com         # HF 下载端点（tei 首启下载 + docling 预热/
#                                           # 兜底下载共用，默认国内镜像免梯子；海外或
#                                           # 有代理可改回 https://huggingface.co）
# EMBEDDING_DIMS=512             # 换模型须核对维度（backend 与 mcp-servers 对称）
# EMBEDDING_BATCH_SIZE=24
# EMBEDDING_BASE_URL=http://tei:8082/v1     # 改用外部嵌入端点时覆盖并 stop tei

# ===================== 知识库（RAG）=====================
# KB_ENABLED=true
# KB_TOP_K=5
# KB_STORE_MINIO=true
# KB_PARSER_ENGINE=legacy        # 切 docling 前先做模型预热（见 compose 注释 runbook）
# KB_DOCLING_DEVICE=cuda         # auto=按 torch 探测，缺卡回落 cpu
# KB_DOCLING_SHARD_PAGES=100
# KB_DOCLING_THREADS=4
# KB_UNIT_MAX_CHARS=2000
# KB_DOCLING_ARTIFACTS_PATH=/models/docling/artifacts   # 注意 `-` 形式：置空用
#                                                      # KB_DOCLING_ARTIFACTS_PATH=
# HF_HOME=/models/docling/hf-cache
# HF_HUB_OFFLINE=1
